{
  "name": "@orisift/sdk",
  "version": "1.3.0",
  "description": "Official TypeScript SDK for Orisift contact-data validation. Server-side only.",
  "keywords": [
    "orisift",
    "validation",
    "phone-validation",
    "email-validation",
    "contact-data",
    "libphonenumber",
    "typescript",
    "sdk"
  ],
  "homepage": "https://orisift.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orisift/orisift-node.git"
  },
  "bugs": {
    "url": "https://github.com/orisift/orisift-node/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./supabase": {
      "types": "./dist/integrations/supabase.d.ts",
      "import": "./dist/integrations/supabase.js",
      "require": "./dist/integrations/supabase.js",
      "default": "./dist/integrations/supabase.js"
    },
    "./enforcement": {
      "types": "./dist/enforcement.d.ts",
      "import": "./dist/enforcement.js",
      "require": "./dist/enforcement.js",
      "default": "./dist/enforcement.js"
    }
  },
  "browser": false,
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
