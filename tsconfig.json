{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
